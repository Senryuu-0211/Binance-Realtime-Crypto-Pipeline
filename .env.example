# =============================================================================
# Copy this file to ".env" and adjust as needed:   cp .env.example .env
#
# docker-compose.yml reads these via ${VAR:-default}, so every value here is
# OPTIONAL — the stack boots with these same defaults even without a .env.
# (.env is gitignored; .env.example is committed as the documented template.)
# =============================================================================

# --- What to track --------------------------------------------------------
# Comma-separated Binance symbols. Case-insensitive; the producer lowercases
# them for the WS stream names. Add more freely, e.g. BTCUSDT,ETHUSDT,SOLUSDT
SYMBOLS=BTCUSDT,ETHUSDT

# Binance public market-stream base URL. The producer appends the combined
# stream path (e.g. /stream?streams=btcusdt@trade/ethusdt@trade).
# Alternative host if you ever get geo-blocked: wss://data-stream.binance.vision
BINANCE_WS_BASE=wss://stream.binance.com:9443

# Binance REST base — used ONLY by the peak seeder (make seed-peaks) to fetch
# historical klines. If api.binance.com is geo-blocked (HTTP 451) in your region,
# switch to the open mirror: https://data-api.binance.vision
BINANCE_REST_BASE=https://api.binance.com

# --- Kafka (KRaft, single broker) -----------------------------------------
# Internal address other containers use. Don't change unless you rename the
# service. (From your dev machine/host, use localhost:19092 — the EXTERNAL
# advertised listener — instead.)
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=trades
# Consumer group id — committed offsets are tracked per group.
KAFKA_GROUP_ID=clickhouse-writer

# --- Schema Registry (message-schema contract, Avro) ----------------------
# The producer registers the trade schema here (subject 'trades-value') and the
# consumer fetches it back by id. Internal address other containers use; from the
# host it's http://localhost:8081 (e.g. `curl localhost:8081/subjects`).
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# --- ClickHouse -----------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123          # HTTP interface (what the consumer + seeder use)
CLICKHOUSE_DB=crypto
CLICKHOUSE_TABLE=trades
CLICKHOUSE_USER=default
# Password for the ClickHouse user. Leave EMPTY for no password (fine local/dev).
# NOTE: keep this comment on its own line — an inline comment after an empty value
# can leak into the value depending on the parser. If you set a password here, it
# must match what the ClickHouse volume was initialized with (else 403 auth errors;
# wipe with `docker compose down -v` to re-init cleanly).
CLICKHOUSE_PASSWORD=

# --- Consumer batching (why: ClickHouse hates row-by-row inserts) ---------
# Flush to ClickHouse when EITHER limit is hit first:
BATCH_SIZE=1000               # ...this many buffered rows, OR
FLUSH_INTERVAL_SECONDS=2      # ...this many seconds since the last flush.

# --- Health check + alerting ----------------------------------------------
# The healthcheck service runs every interval and writes results to
# crypto.health_checks (Grafana shows them + alerts on them).
HEALTH_CHECK_INTERVAL_SECONDS=300     # how often to run the checks (5 min)
FRESHNESS_THRESHOLD_SECONDS=120       # overall: newest trade older than this => STALE
# Per-symbol stall: looser than freshness on purpose — a low-volume coin has
# longer natural gaps than BTC, so too-tight a value false-alarms at quiet times.
SYMBOL_STALL_THRESHOLD_SECONDS=300    # a symbol with no trade for this long => STALLED

# --- Backfill (self-healing gap remediation) ------------------------------
# The backfiller re-fetches trades the WebSocket lost during a reconnect, using
# Binance's /api/v3/historicalTrades (ids match our dedup key). That endpoint
# needs an API KEY. Create a read-only key at binance.com (no secret needed —
# only the key header is sent). Leave EMPTY to keep backfill DISABLED: the
# service then just idles and logs "disabled" (gap DETECTION still runs in the
# healthcheck; only auto-remediation is off).
BINANCE_API_KEY=
BACKFILL_INTERVAL_SECONDS=300         # how often to scan for gaps and heal them
BACKFILL_WINDOW_MINUTES=15            # look back this far for gaps (>= gap-check window)
BACKFILL_MAX_GAP=500000               # skip "gaps" bigger than this (cold-start/outage, not a WS blip)

# --- Grafana --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Logging --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR  (applies to producer, consumer & seeder)
LOG_LEVEL=INFO
